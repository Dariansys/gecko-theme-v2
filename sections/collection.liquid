{{ 'gecko-featured-products.css' | asset_url | stylesheet_tag }}
{{ 'gecko-collection.css' | asset_url | stylesheet_tag }}
<section class="gecko-collection surface-light full-width" aria-labelledby="GeckoCollectionTitle-{{ section.id }}">
  <div class="gecko-container gecko-container--wide">
    <header class="gecko-collection__header">
      <h1 class="gecko-collection__title" id="GeckoCollectionTitle-{{ section.id }}">{{ collection.title | escape }}</h1>
      {% if section.settings.show_description and collection.description != blank %}
        <div class="gecko-collection__description">{{ collection.description }}</div>
      {% endif %}
      {% if section.settings.show_product_count %}
        <p class="gecko-collection__count gecko-label">{{ 'gecko_collection.product_count' | t: count: collection.products_count }}</p>
      {% endif %}
    </header>

    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 %}
        <ul class="gecko-collection__grid" role="list">
          {% for product in collection.products %}
            {% assign accent_index = paginate.current_offset | plus: forloop.index0 %}
            <li>
              {% render 'gecko-product-card', product: product, show_price: section.settings.show_price, show_vendor: section.settings.show_vendor, show_badge: section.settings.show_badge, accent_index: accent_index %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="gecko-collection__empty" role="status">{{ 'gecko_collection.empty' | t }}</p>
      {% endif %}

      {% assign pagination_label = 'gecko_collection.pagination' | t %}
      {% render 'gecko-pagination', paginate: paginate, label: pagination_label %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "t:general.collection",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "t:gecko_collection.products_per_page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_description", "label": "t:gecko_collection.show_description", "default": true },
    { "type": "checkbox", "id": "show_product_count", "label": "t:gecko_collection.show_product_count", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "t:featured_products.show_vendor", "default": false },
    { "type": "checkbox", "id": "show_price", "label": "t:featured_products.show_price", "default": true },
    { "type": "checkbox", "id": "show_badge", "label": "t:featured_products.show_badge", "default": true }
  ]
}
{% endschema %}
