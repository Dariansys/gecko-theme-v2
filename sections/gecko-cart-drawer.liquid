{{ 'gecko-cart-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gecko-cart-drawer.js' | asset_url }}" defer></script>
<gecko-cart-drawer
  data-section-id="{{ section.id }}"
  data-cart-url="{{ routes.cart_url }}"
  data-add-url="{{ routes.cart_add_url }}"
  data-change-url="{{ routes.cart_change_url }}"
  data-count="{{ cart.item_count }}"
  data-count-label="{{ 'header.cart_count' | t: count: cart.item_count | escape }}"
  data-adding="{{ 'cart_drawer.adding' | t | escape }}"
  data-rejected="{{ 'cart_drawer.rejected' | t | escape }}"
  data-reconciled-error="{{ 'cart_drawer.reconciled_error' | t | escape }}"
  data-loading="{{ 'cart_drawer.loading' | t | escape }}"
  data-error="{{ 'cart_drawer.error' | t | escape }}"
  data-invalid="{{ 'cart_drawer.invalid_quantity' | t | escape }}"
  data-refreshed="{{ 'cart_drawer.refreshed' | t | escape }}"
  data-updated="{{ 'cart_drawer.updated' | t | escape }}"
  data-added="{{ 'cart_drawer.added' | t: title: '[title]' | escape }}"
  data-removed="{{ 'cart_drawer.removed' | t: title: '[title]' | escape }}"
>
  <dialog id="GeckoCartDrawer-{{ section.id }}" class="gecko-cart-drawer surface-light" aria-modal="true" aria-labelledby="GeckoBagTitle-{{ section.id }}" scroll-lock>
    <header class="gecko-cart-drawer__header">
      <div><h2 id="GeckoBagTitle-{{ section.id }}">{{ 'cart_drawer.heading' | t }}</h2><p class="gecko-label" data-drawer-count>{{ 'cart.item_count' | t: count: cart.item_count }}</p></div>
      <button class="gecko-cart-drawer__close" type="button" data-drawer-close aria-label="{{ 'cart_drawer.close' | t | escape }}" autofocus><span aria-hidden="true">×</span></button>
    </header>
    <p class="gecko-cart-drawer__error" role="alert" data-drawer-error></p>
    <p class="gecko-visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-drawer-status></p>
    <div class="gecko-cart-drawer__content" data-drawer-content>
      <div class="gecko-cart-drawer__items" data-drawer-items>
        {% if cart.empty? %}
          <div class="gecko-cart-drawer__empty">
            <h3>{{ 'cart_drawer.empty' | t }}</h3>
            <p>{{ 'cart_drawer.empty_message' | t }}</p>
            <a class="gecko-button gecko-cart-drawer__primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.explore' | t }} <span class="gecko-button__arrow" aria-hidden="true">→</span></a>
          </div>
        {% else %}
          <ul class="gecko-cart-drawer__list" role="list">
            {% for item in cart.items %}{% render 'gecko-cart-drawer-item', item: item, section_id: section.id, index: forloop.index %}{% endfor %}
          </ul>
        {% endif %}
      </div>
      <footer class="gecko-cart-drawer__footer">
        {% unless cart.empty? %}
          {% for discount in cart.cart_level_discount_applications %}<p class="gecko-cart-drawer__discount"><span>{{ discount.title | escape }}</span><span>−{{ discount.total_allocated_amount | money_with_currency }}</span></p>{% endfor %}
          <p class="gecko-cart-drawer__subtotal"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></p>
          <p class="gecko-cart-drawer__meta">{% if cart.taxes_included %}{{ 'cart.taxes_included' | t }}{% else %}{{ 'cart.taxes_shipping' | t }}{% endif %}</p>
          <form action="{{ routes.cart_url }}" method="post"><button class="gecko-button gecko-cart-drawer__primary" type="submit" name="checkout" data-drawer-checkout>{{ 'cart.checkout' | t }} <span class="gecko-button__arrow" aria-hidden="true">→</span></button></form>
        {% endunless %}
        <a class="gecko-cart-drawer__view-cart" href="{{ routes.cart_url }}">{{ 'cart_drawer.view_cart' | t }}</a>
      </footer>
    </div>
  </dialog>
</gecko-cart-drawer>
{% schema %}
{
  "name": "t:cart_drawer.name",
  "class": "gecko-cart-drawer-section",
  "settings": []
}
{% endschema %}
