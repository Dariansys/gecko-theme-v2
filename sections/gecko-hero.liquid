{{ 'gecko-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gecko-hero.js' | asset_url }}" defer></script>
{% liquid
  assign headline = section.settings.headline | strip
  assign headline_accent = section.settings.headline_accent | strip
  assign rendered_headline = headline | escape | newline_to_br
  if headline_accent != blank and headline_accent != headline and headline contains headline_accent
    assign headline_prefix = headline | split: headline_accent | first
    assign prefix_with_accent = headline_prefix | append: headline_accent
    assign headline_suffix = headline | remove_first: prefix_with_accent
    capture rendered_headline
      echo headline_prefix | escape | newline_to_br
      echo '<span class="gecko-hero__headline-accent">'
      echo headline_accent | escape
      echo '</span>'
      echo headline_suffix | escape | newline_to_br
    endcapture
  endif
  assign hero_image = section.settings.hero_image | default: section.settings.mobile_image
  assign slide_count = 0
  for block in section.blocks
    if block.settings.image != blank or block.settings.mobile_image != blank or request.design_mode
      assign slide_count = slide_count | plus: 1
    endif
  endfor
  if slide_count == 0 and hero_image != blank
    assign slide_count = 1
  endif
  assign primary_url = section.settings.primary_link | default: routes.all_products_collection_url
  assign has_actions = false
  if section.settings.primary_label != blank and primary_url != blank
    assign has_actions = true
  elsif section.settings.secondary_label != blank and section.settings.secondary_link != blank
    assign has_actions = true
  endif
%}
<section
  class="gecko-hero surface-light"
  {% if headline != blank %}aria-labelledby="GeckoHeroTitle-{{ section.id }}"{% endif %}
  data-gradient-enabled="{{ section.settings.show_gradient }}"
  data-gradient-intensity="{{ section.settings.gradient_intensity }}"
>
  <div class="gecko-hero__layout gecko-container gecko-container--wide">
    <div class="gecko-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="gecko-hero__eyebrow gecko-label">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if headline != blank %}
        <h1 id="GeckoHeroTitle-{{ section.id }}" class="gecko-hero__headline">{{ rendered_headline }}</h1>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="gecko-hero__body gecko-body-large">{{ section.settings.body | escape | newline_to_br }}</p>
      {% endif %}
      {% if has_actions %}
        <div class="gecko-hero__actions">
          {% if section.settings.primary_label != blank and primary_url != blank %}
            <a class="gecko-button gecko-button--primary" href="{{ primary_url | escape }}">
              {{ section.settings.primary_label | escape }}
              <span class="gecko-button__arrow" aria-hidden="true">→</span>
            </a>
          {% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="gecko-button gecko-button--text" href="{{ section.settings.secondary_link | escape }}">
              {{ section.settings.secondary_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <gecko-hero-slideshow
      class="gecko-hero__media"
      role="region"
      aria-roledescription="{{ 'hero.carousel' | t }}"
      aria-label="{{ 'hero.slideshow' | t }}"
      data-section-id="{{ section.id }}"
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.autoplay_interval }}"
      data-status-template="{{ 'hero.slide_status' | t: current: '{current}', total: slide_count | escape }}"
    >
      <div id="GeckoHeroSlides-{{ section.id }}" class="gecko-hero__slides">
        {% assign slide_index = 0 %}
        {% for block in section.blocks %}
          {% if block.settings.image != blank or block.settings.mobile_image != blank or request.design_mode %}
            {% assign slide_index = slide_index | plus: 1 %}
            {% render 'gecko-hero-slide', section_id: section.id, block: block, index: slide_index, total: slide_count %}
          {% endif %}
        {% endfor %}
        {% if slide_index == 0 and hero_image != blank %}
          {% render 'gecko-hero-slide', section_id: section.id, legacy_settings: section.settings, index: 1, total: 1 %}
        {% elsif slide_count == 0 %}
          <div class="gecko-hero__empty" aria-hidden="true"></div>
          {% if request.design_mode %}
            <p class="gecko-hero__image-hint">{{ 'hero.image_hint' | t }}</p>
          {% endif %}
        {% endif %}
      </div>
      {% if slide_count > 1 %}
        {% if section.settings.show_counter %}
          <span class="gecko-hero__counter" aria-hidden="true" data-hero-counter>01 / {% if slide_count < 10 %}0{% endif %}{{ slide_count }}</span>
        {% endif %}
        <div class="gecko-hero__controls" data-hero-controls hidden>
          {% if section.settings.show_arrows %}
            <div class="gecko-hero__arrows">
              <button class="gecko-hero__control" type="button" data-hero-prev aria-label="{{ 'hero.previous' | t }}" aria-controls="GeckoHeroSlides-{{ section.id }}"><span aria-hidden="true">←</span></button>
              <button class="gecko-hero__control" type="button" data-hero-next aria-label="{{ 'hero.next' | t }}" aria-controls="GeckoHeroSlides-{{ section.id }}"><span aria-hidden="true">→</span></button>
            </div>
          {% endif %}
          <div class="gecko-hero__toolbar">
            {% if section.settings.show_pagination %}
              <div class="gecko-hero__pagination" aria-label="{{ 'hero.pagination' | t }}">
                {% assign dot_index = 0 %}
                {% for block in section.blocks %}
                  {% if block.settings.image != blank or block.settings.mobile_image != blank or request.design_mode %}
                    {% assign dot_index = dot_index | plus: 1 %}
                    <button class="gecko-hero__dot" type="button" data-hero-dot="{{ dot_index | minus: 1 }}" aria-label="{{ 'hero.go_to_slide' | t: number: dot_index }}" aria-controls="GeckoHeroSlide-{{ section.id }}-{{ block.id }}" {% if dot_index == 1 %}aria-current="true"{% endif %}><span aria-hidden="true"></span></button>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
            {% if section.settings.autoplay %}
              <button class="gecko-hero__control gecko-hero__play" type="button" data-hero-play aria-label="{{ 'hero.pause' | t }}" data-pause-label="{{ 'hero.pause' | t }}" data-play-label="{{ 'hero.play' | t }}"><span data-hero-play-icon aria-hidden="true">Ⅱ</span></button>
            {% endif %}
          </div>
        </div>
        <p class="gecko-visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-hero-status></p>
      {% endif %}
    </gecko-hero-slideshow>
  </div>
</section>

{% schema %}
{
  "name": "t:hero.name",
  "class": "gecko-hero-section",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:hero.eyebrow",
      "default": "t:hero.defaults.eyebrow"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "t:hero.headline",
      "default": "t:hero.defaults.headline"
    },
    {
      "type": "text",
      "id": "headline_accent",
      "label": "t:hero.headline_accent",
      "info": "t:hero.headline_accent_info",
      "default": "t:hero.defaults.headline_accent"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:hero.body",
      "default": "t:hero.defaults.body"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:hero.primary_label",
      "default": "t:hero.defaults.primary_label"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:hero.primary_link",
      "info": "t:hero.primary_link_info"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:hero.secondary_label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:hero.secondary_link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "t:hero.hero_image",
      "info": "t:hero.image_info"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:hero.mobile_image",
      "info": "t:hero.mobile_image_info"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "t:hero.image_alt",
      "info": "t:hero.image_alt_info"
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "t:hero.show_gradient",
      "default": true
    },
    {
      "type": "select",
      "id": "gradient_intensity",
      "label": "t:hero.gradient_intensity",
      "options": [
        {
          "value": "subtle",
          "label": "t:hero.subtle"
        },
        {
          "value": "standard",
          "label": "t:hero.standard"
        }
      ],
      "default": "standard"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:hero.autoplay",
      "default": true
    },
    {
      "type": "select",
      "id": "autoplay_interval",
      "label": "t:hero.autoplay_interval",
      "options": [
        {
          "value": "4",
          "label": "t:hero.seconds_4"
        },
        {
          "value": "5",
          "label": "t:hero.seconds_5"
        },
        {
          "value": "6",
          "label": "t:hero.seconds_6"
        },
        {
          "value": "8",
          "label": "t:hero.seconds_8"
        }
      ],
      "default": "5"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "t:hero.show_arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "t:hero.show_pagination",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "t:hero.show_counter",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:hero.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "blocks": [
    {
      "type": "slide",
      "name": "t:hero.slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:hero.desktop_image",
          "info": "t:hero.slide_image_info"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:hero.mobile_image",
          "info": "t:hero.mobile_image_info"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:hero.slide_label"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:hero.slide_caption"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "t:hero.image_alt",
          "info": "t:hero.image_alt_info"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "t:hero.image_fit",
          "options": [
            {
              "value": "cover",
              "label": "t:hero.cover"
            },
            {
              "value": "contain",
              "label": "t:hero.contain"
            }
          ],
          "default": "cover"
        }
      ]
    }
  ]
}
{% endschema %}
