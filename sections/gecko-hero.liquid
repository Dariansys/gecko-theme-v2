{{ 'gecko-hero.css' | asset_url | stylesheet_tag }}
{% liquid
  assign headline = section.settings.headline | strip
  assign headline_accent = section.settings.headline_accent | strip
  assign rendered_headline = headline | escape | newline_to_br
  if headline_accent != blank and headline_accent != headline and headline contains headline_accent
    assign headline_prefix = headline | split: headline_accent | first
    assign prefix_with_accent = headline_prefix | append: headline_accent
    assign headline_suffix = headline | remove_first: prefix_with_accent
    capture rendered_headline
      echo headline_prefix | escape | newline_to_br
      echo '<span class="gecko-hero__headline-accent">'
      echo headline_accent | escape
      echo '</span>'
      echo headline_suffix | escape | newline_to_br
    endcapture
  endif
  assign hero_image = section.settings.hero_image | default: section.settings.mobile_image
  assign image_alt = section.settings.image_alt | default: hero_image.alt
  assign primary_url = section.settings.primary_link | default: routes.all_products_collection_url
  assign has_actions = false
  if section.settings.primary_label != blank and primary_url != blank
    assign has_actions = true
  elsif section.settings.secondary_label != blank and section.settings.secondary_link != blank
    assign has_actions = true
  endif
%}
<section
  class="gecko-hero surface-light"
  {% if headline != blank %}aria-labelledby="GeckoHeroTitle-{{ section.id }}"{% endif %}
  data-gradient-enabled="{{ section.settings.show_gradient }}"
  data-gradient-intensity="{{ section.settings.gradient_intensity }}"
>
  <div class="gecko-hero__layout gecko-container gecko-container--wide">
    <div class="gecko-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="gecko-hero__eyebrow gecko-label">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if headline != blank %}
        <h1 id="GeckoHeroTitle-{{ section.id }}" class="gecko-hero__headline">{{ rendered_headline }}</h1>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="gecko-hero__body gecko-body-large">{{ section.settings.body | escape | newline_to_br }}</p>
      {% endif %}
      {% if has_actions %}
        <div class="gecko-hero__actions">
          {% if section.settings.primary_label != blank and primary_url != blank %}
            <a class="gecko-button gecko-button--primary" href="{{ primary_url | escape }}">
              {{ section.settings.primary_label | escape }}
              <span class="gecko-button__arrow" aria-hidden="true">→</span>
            </a>
          {% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
            <a class="gecko-button gecko-button--text" href="{{ section.settings.secondary_link | escape }}">
              {{ section.settings.secondary_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <div class="gecko-hero__media">
      {% if hero_image != blank %}
        <picture class="gecko-hero__picture">
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 767px)"
              srcset="{% assign mobile_widths = '400,600,800' | split: ',' %}{% for mobile_width in mobile_widths %}{% assign candidate_width = mobile_width | plus: 0 %}{% if candidate_width < section.settings.mobile_image.width %}{{ section.settings.mobile_image | image_url: width: candidate_width }} {{ candidate_width }}w, {% endif %}{% endfor %}{{ section.settings.mobile_image | image_url: width: 1200 }} {{ section.settings.mobile_image.width | at_most: 1200 }}w"
              sizes="calc(100vw - 5rem)"
              width="{{ section.settings.mobile_image.width }}"
              height="{{ section.settings.mobile_image.height }}"
            >
          {% endif %}
          {{
            hero_image
            | image_url: width: 2400
            | image_tag:
              class: 'gecko-hero__image',
              widths: '400, 600, 800, 1000, 1200, 1600, 2000, 2400',
              sizes: '(min-width: 1920px) 800px, (min-width: 1024px) 48vw, (min-width: 768px) 80vw, calc(100vw - 5rem)',
              loading: 'eager',
              fetchpriority: 'high',
              alt: image_alt
          }}
        </picture>
      {% else %}
        <div class="gecko-hero__empty" aria-hidden="true"></div>
        {% if request.design_mode %}
          <p class="gecko-hero__image-hint">{{ 'hero.image_hint' | t }}</p>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:hero.name",
  "class": "gecko-hero-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:hero.eyebrow", "default": "t:hero.defaults.eyebrow" },
    { "type": "textarea", "id": "headline", "label": "t:hero.headline", "default": "t:hero.defaults.headline" },
    { "type": "text", "id": "headline_accent", "label": "t:hero.headline_accent", "info": "t:hero.headline_accent_info", "default": "t:hero.defaults.headline_accent" },
    { "type": "textarea", "id": "body", "label": "t:hero.body", "default": "t:hero.defaults.body" },
    { "type": "text", "id": "primary_label", "label": "t:hero.primary_label", "default": "t:hero.defaults.primary_label" },
    { "type": "url", "id": "primary_link", "label": "t:hero.primary_link", "info": "t:hero.primary_link_info" },
    { "type": "text", "id": "secondary_label", "label": "t:hero.secondary_label" },
    { "type": "url", "id": "secondary_link", "label": "t:hero.secondary_link" },
    { "type": "image_picker", "id": "hero_image", "label": "t:hero.hero_image", "info": "t:hero.image_info" },
    { "type": "image_picker", "id": "mobile_image", "label": "t:hero.mobile_image", "info": "t:hero.mobile_image_info" },
    { "type": "text", "id": "image_alt", "label": "t:hero.image_alt", "info": "t:hero.image_alt_info" },
    { "type": "checkbox", "id": "show_gradient", "label": "t:hero.show_gradient", "default": true },
    { "type": "select", "id": "gradient_intensity", "label": "t:hero.gradient_intensity", "options": [
      { "value": "subtle", "label": "t:hero.subtle" },
      { "value": "standard", "label": "t:hero.standard" }
    ], "default": "standard" }
  ],
  "presets": [{ "name": "t:hero.name" }]
}
{% endschema %}
