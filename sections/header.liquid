{{ 'gecko-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gecko-header.js' | asset_url }}" defer></script>
<header class="gecko-header surface-light" data-sticky="{{ section.settings.sticky_header }}">
  <div class="gecko-header__inner gecko-container gecko-container--wide">
    <div class="gecko-header__brand">
      {% render 'gecko-brand-lockup', brand_settings: section.settings %}
    </div>

    {% if section.settings.menu.links != blank %}
      <nav class="gecko-header__nav" aria-label="{{ 'header.navigation' | t | escape }}">
        {% render 'gecko-desktop-navigation', menu: section.settings.menu, section_id: section.id %}
      </nav>
    {% endif %}

    <div class="gecko-header__actions">
      {% if section.settings.show_search %}
        <a class="gecko-header__action gecko-header__action--search" href="{{ routes.search_url }}">
          {{ 'header.search' | t }}
        </a>
      {% endif %}
      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        <a class="gecko-header__action gecko-header__action--account" href="{{ routes.account_url }}">
          {{ 'header.account' | t }}
        </a>
      {% endif %}
      <a class="gecko-header__action gecko-header__action--bag" href="{{ routes.cart_url }}">
        <span>{{ 'header.bag' | t }}</span>
        {% if section.settings.show_cart_count %}
          <span aria-hidden="true">({{ cart.item_count }})</span>
          <span class="gecko-visually-hidden">{{ 'header.cart_count' | t: count: cart.item_count }}</span>
        {% endif %}
      </a>
      {% render 'gecko-mobile-navigation', header_settings: section.settings, section_id: section.id %}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "class": "gecko-header-section",
  "settings": [
    {
      "type": "header",
      "content": "t:general.brand_lockup"
    },
    {
      "type": "image_picker",
      "id": "brand_mark",
      "label": "t:labels.brand_mark"
    },
    {
      "type": "range",
      "id": "brand_mark_width",
      "label": "t:labels.brand_mark_width",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "image_picker",
      "id": "wordmark",
      "label": "t:labels.wordmark"
    },
    {
      "type": "range",
      "id": "wordmark_width",
      "label": "t:labels.wordmark_width",
      "min": 80,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "brand_gap",
      "label": "t:labels.brand_gap",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "text",
      "id": "brand_fallback_text",
      "label": "t:labels.brand_fallback_text",
      "info": "t:labels.brand_fallback_text_info"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.main_menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "t:labels.sticky_header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "t:labels.show_account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:labels.show_search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_count",
      "label": "t:labels.show_cart_count",
      "default": true
    }
  ]
}
{% endschema %}
