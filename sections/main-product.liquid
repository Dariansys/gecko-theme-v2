{{ 'gecko-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gecko-product.js' | asset_url }}" defer></script>
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'GeckoProductForm-' | append: section.id
  assign quantity_id = 'GeckoQuantity-' | append: section.id
%}
<gecko-product class="gecko-product full-width" data-section-id="{{ section.id }}" data-product-url="{{ product.url }}" data-update-error="{{ 'gecko_product.update_error' | t | escape }}" data-updating="{{ 'gecko_product.updating' | t | escape }}">
  <div class="gecko-product__layout gecko-container gecko-container--wide">
    {% render 'product-media-gallery', product: product, current_variant: current_variant, section_id: section.id %}
    <div class="gecko-product__details" data-product-details data-selected-media="{{ current_variant.featured_media.id }}" data-selected-variant="{{ current_variant.id }}" data-available="{{ current_variant.available | default: false }}">
      {% if section.settings.show_vendor and product.vendor != blank %}<p class="gecko-label gecko-product__vendor">{{ product.vendor | escape }}</p>{% endif %}
      <h1 class="gecko-product__title">{{ product.title | escape }}</h1>
      <div class="gecko-product__price">
        {% if current_variant %}
          <span class="gecko-visually-hidden">{{ 'gecko_product.price' | t }}</span><span>{{ current_variant.price | money_with_currency }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}<span class="gecko-visually-hidden">{{ 'gecko_product.regular_price' | t }}</span><s>{{ current_variant.compare_at_price | money_with_currency }}</s>{% endif %}
        {% else %}<span>{{ 'gecko_product.unavailable' | t }}</span>{% endif %}
      </div>
      {% unless current_variant.available %}<p class="gecko-product__availability">{% if current_variant %}{{ 'gecko_product.sold_out' | t }}{% else %}{{ 'gecko_product.unavailable' | t }}{% endif %}</p>{% endunless %}
      {% form 'product', product, id: form_id, class: 'gecko-product__form' %}
        {% if form.errors %}<div role="alert" class="gecko-product__form-error">{{ form.errors | default_errors }}</div>{% endif %}
        {% render 'product-variant-picker', product: product, current_variant: current_variant, section_id: section.id %}
        <div class="gecko-product__purchase">
          <div class="gecko-product__quantity">
            <label for="{{ quantity_id }}">{{ 'gecko_product.quantity' | t }}</label>
            <input id="{{ quantity_id }}" type="number" name="quantity" value="{{ current_variant.quantity_rule.min | default: 1 }}" min="{{ current_variant.quantity_rule.min | default: 1 }}" step="{{ current_variant.quantity_rule.increment | default: 1 }}"{% if current_variant.quantity_rule.max %} max="{{ current_variant.quantity_rule.max }}"{% endif %} inputmode="numeric" required>
          </div>
          <button class="gecko-product__add" type="submit" name="add" data-primary-add{% unless current_variant.available %} disabled{% endunless %}>{% if current_variant.available %}{{ 'gecko_product.add' | t }}{% elsif current_variant %}{{ 'gecko_product.sold_out' | t }}{% else %}{{ 'gecko_product.unavailable' | t }}{% endif %}<span aria-hidden="true">→</span></button>
        </div>
          <button class="gecko-product__add gecko-product__fallback-add" type="submit" name="add"{% unless product.available %} disabled{% endunless %}>{% if product.available %}{{ 'gecko_product.add' | t }}{% else %}{{ 'gecko_product.sold_out' | t }}{% endif %}</button>
        {% if section.settings.show_dynamic_checkout and current_variant.available %}<div class="gecko-product__checkout">{{ form | payment_button }}</div>{% endif %}
      {% endform %}
      {% if product.description != blank %}<div class="gecko-product__description">{{ product.description }}</div>{% endif %}
      {% if section.settings.shipping_note != blank %}<p class="gecko-product__note">{{ section.settings.shipping_note | escape }}</p>{% endif %}
    </div>
  </div>
  <p class="gecko-visually-hidden" data-product-status role="status" aria-live="polite" aria-atomic="true"></p>
</gecko-product>
{% schema %}
{
  "name": "t:gecko_product.name",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "t:gecko_product.show_vendor", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:gecko_product.show_dynamic_checkout", "default": false },
    { "type": "text", "id": "shipping_note", "label": "t:gecko_product.shipping_note" }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
