{% comment %}Native media in a consistent contained stage. First visible media loads eagerly.{% endcomment %}
{% assign model_media = product.media | where: 'media_type', 'model' %}
{% if model_media.size > 0 %}
  {{ 'gecko-product-model.css' | asset_url | stylesheet_tag }}
{% endif %}
{% liquid
  assign first_media = current_variant.featured_media | default: product.featured_media
  assign first_ratio = first_media.preview_image.aspect_ratio | default: first_media.aspect_ratio | default: 1
%}
<div class="gecko-product__gallery" data-gallery role="region" aria-label="{{ 'gecko_product.gallery' | t | escape }}">
  {% if product.media.size > 0 %}
    <div class="gecko-product__media-frame gecko-product-media">
      <div class="gecko-product__track" style="--gecko-media-aspect: {{ first_ratio }};" data-media-track tabindex="0" id="GeckoMedia-{{ section_id }}">
        {% assign slide_index = 0 %}
        {% for pass in (1..2) %}
          {% for media in product.media %}
            {% if pass == 1 and media.id != first_media.id %}{% continue %}{% endif %}
            {% if pass == 2 and media.id == first_media.id %}{% continue %}{% endif %}
            {% assign slide_index = slide_index | plus: 1 %}
            {% assign media_ratio = media.preview_image.aspect_ratio | default: media.aspect_ratio | default: 1 %}
            <div class="gecko-product__slide" data-media-id="{{ media.id }}" data-media-aspect="{{ media_ratio }}" role="group" aria-roledescription="{{ 'gecko_product.slide' | t | escape }}" aria-label="{{ 'gecko_product.media_position' | t: current: slide_index, total: product.media.size | escape }}">
              {% case media.media_type %}
                {% when 'image' %}
                  {% liquid
                    assign loading = 'lazy'
                    assign priority = 'low'
                    if slide_index == 1
                      assign loading = 'eager'
                      assign priority = 'high'
                    endif
                    assign image_alt = media.alt | default: product.title
                  %}
                  {{ media | image_url: width: 2000 | image_tag:
                    widths: '375, 600, 800, 1000, 1400, 1800, 2000',
                    sizes: '(min-width: 1920px) 860px, (min-width: 1024px) 55vw, calc(100vw - 2rem)',
                    loading: loading, fetchpriority: priority, alt: image_alt
                  }}
                {% when 'video' %}
                  {{ media | video_tag: controls: true, preload: 'none', image_size: '1000x', autoplay: false }}
                {% when 'external_video' %}
                  {{ media | external_video_tag: loading: 'lazy', title: media.alt }}
                {% when 'model' %}
                  {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, image_size: '1000x' }}
              {% endcase %}
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
    {% if product.media.size > 1 %}
      <div class="gecko-product__gallery-controls" data-gallery-controls hidden>
        <button type="button" data-media-prev aria-controls="GeckoMedia-{{ section_id }}" aria-label="{{ 'gecko_product.previous' | t | escape }}"><span aria-hidden="true">←</span></button>
        <span data-media-count aria-live="polite" aria-atomic="true">{{ 'gecko_product.media_position' | t: current: 1, total: product.media.size }}</span>
        <button type="button" data-media-next aria-controls="GeckoMedia-{{ section_id }}" aria-label="{{ 'gecko_product.next' | t | escape }}"><span aria-hidden="true">→</span></button>
      </div>
    {% endif %}
  {% else %}
    <div class="gecko-product__empty-media gecko-product-media">{% render 'product-media-placeholder' %}</div>
  {% endif %}
</div>
